{
  "compilerOptions": {
    "target": "ES2018",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "outDir": "./dist",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@ellipsa/shared/*": [
        "../../packages/shared/src/*"
      ],
      "@ellipsa/action/*": [
        "../../packages/action/src/*"
      ],
      "@ellipsa/prompt/*": [
        "../../packages/prompt/src/*"
      ],
      "@/*": [
        "./src/*"
      ]
    },
    "preserveSymlinks": true,
    "typeRoots": [
      "./node_modules/@types",
      "./src/@types"
    ],
    "types": [
      "node"
    ],
    "noEmitOnError": false,
    "removeComments": false,
    "sourceMap": true,
    "allowJs": true,
    "checkJs": false,
    "declaration": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts",
    "dist",
    "src/renderer/**/*",
    "src/preload/**/*"
  ]
}